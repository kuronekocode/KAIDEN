{
  "name": "@kaiden/core",
  "version": "0.1.0",
  "description": "kaiden コアライブラリ - スキーマ検証、AGENTS.md生成",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "validate:schemas": "tsx src/scripts/validate-schemas.ts",
    "validate:data": "tsx src/scripts/validate-data.ts",
    "generate:types": "tsx src/scripts/generate-types.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "semver": "^7.6.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kaiden",
    "llm",
    "schema",
    "validation"
  ],
  "author": "kuronekocode",
  "license": "MIT"
}
